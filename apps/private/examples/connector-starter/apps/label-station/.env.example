# Copy to apps/label-station/.env and fill from your `tot app install --app apps/label-station --env test --tenant <store>` output.
# This file holds a secret: it is gitignored. Never commit it, paste it in chat, or give it to your AI agent.
TOT_TENANT=
TOT_INSTALL_ID=
TOT_CLIENT_ID=
TOT_CLIENT_SECRET=

# Public HTTPS URL of your tunnel (no trailing slash, no /webhooks). See README "Tunnel".
WEBHOOK_PUBLIC_URL=
# Local port your tunnel forwards to.
PORT=8787

# Seconds until the mock carrier "picks up" a labelled parcel (then the app reports handoff).
MOCK_PICKUP_SECONDS=5
# 1 = void the first label and buy a replacement (exercises label-voided).
MOCK_VOID_FIRST=0
# Later, a real label provider (leave empty to use the in-process mock):
PROVIDER_API_URL=
PROVIDER_API_KEY=
PROVIDER_API_SECRET=
