# Copy to apps/inventory-sync/.env and fill from your `tot app install --app apps/inventory-sync --env test --tenant <store>` output.
# This file holds a secret: it is gitignored. Never commit it, paste it in chat, or give it to your AI agent.
TOT_TENANT=
TOT_INSTALL_ID=
TOT_CLIENT_ID=
TOT_CLIENT_SECRET=

# Public HTTPS URL of your tunnel (no trailing slash, no /webhooks). See README "Tunnel".
WEBHOOK_PUBLIC_URL=
# Local port your tunnel forwards to.
PORT=8787

# Seconds between WMS -> Storefront level syncs.
SYNC_SECONDS=30
# Storefront location the counts go to. Keep FULFILLABLE=0 on any store you do not own.
STARTER_LOCATION_ID=loc-starter-wms
STARTER_LOCATION_FULFILLABLE=0
# Mock: how many of the store SKUs to stock, and how often stock moves (receive/pick/damage/cycle count).
MOCK_SKU_COUNT=3
MOCK_DRIFT_SECONDS=20
# Later, a real WMS (leave empty to use the in-process mock):
PROVIDER_API_URL=

# Only for tot app conformance: read the run's signing key instead of the store's.
# TOT_METADATA_ORIGIN=http://127.0.0.1:37891
