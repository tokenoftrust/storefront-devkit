# Copy to apps/dropship/.env and fill from your `tot app install --app apps/dropship --env test --tenant <store>` output.
# This file holds a secret: it is gitignored. Never commit it, paste it in chat, or give it to your AI agent.
TOT_TENANT=
TOT_INSTALL_ID=
TOT_CLIENT_ID=
TOT_CLIENT_SECRET=

# Public HTTPS URL of your tunnel (no trailing slash, no /webhooks). See README "Tunnel".
WEBHOOK_PUBLIC_URL=
# Local port your tunnel forwards to.
PORT=8787

# Your preview location for test orders (npm run order -- dropship bind|create).
STARTER_LOCATION_ID=loc-starter-dropship

# Seconds before the mock supplier ships (or backorders).
MOCK_SHIP_SECONDS=8
# 1 = the supplier backorders every line (exercises /exceptions).
MOCK_BACKORDER=0
# Carrier the mock supplier uses. USPS shows Storefront refusing a non-PACT carrier.
MOCK_SUPPLIER_CARRIER=UPS
# Later, a real dropship platform (leave empty to use the in-process mock):
PROVIDER_API_URL=
