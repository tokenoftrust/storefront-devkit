# Copy to .env (never committed). Used by `npm run e2e` and readable by `node index.mjs --live`
# when exported. Values from `tot app install --app . --env test --tenant <store>`.
TOT_TENANT=
TOT_CLIENT_ID=
TOT_CLIENT_SECRET=
# Public tunnel to http://127.0.0.1:8787, set as the webhook endpoint of the
# connector-starter inventory-sync and dropship test installs.
WEBHOOK_PUBLIC_URL=
# Optional
# E2E_LOCATION_ID=loc-e2e-dropship
# TOT_BIN=tot
