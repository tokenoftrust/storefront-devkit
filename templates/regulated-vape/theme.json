{
  "$schema": "../../schemas/theme.schema.json",
  "color": {
    "bg": "#0B0E14",
    "surface": "#12161F",
    "surface-2": "#1A1F2B",
    "text": "#EEF1F6",
    "muted": "#98A2B3",
    "primary": "#C8102E",
    "primary-contrast": "#FFFFFF",
    "accent": "#1E3A8A",
    "border": "#242B38",
    "success": "#3FB27F",
    "sale": "#C8102E"
  },
  "type": {
    "display": { "family": "Archivo", "weights": [600, 700] },
    "body": { "family": "Inter", "weights": [400, 500] },
    "mono": { "family": "Space Mono", "weights": [400] },
    "scale": 1.2,
    "tracking": "-0.01em"
  },
  "space": { "base": 4, "containerMaxWidth": "1240px", "sectionRhythm": "clamp(3rem, 7vw, 6rem)" },
  "shape": { "radius": { "sm": "3px", "md": "6px", "lg": "12px", "full": "999px" } },
  "brand": { "logoLight": "/brand/logo.svg", "favicon": "/favicon.svg", "motion": "reduced" }
}
