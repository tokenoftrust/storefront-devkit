{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokenoftrust.com/storefront-devkit/schemas/pages.schema.json",
  "title": "ToT Storefront content/pages/*.json (block-palette@3)",
  "description": "A single editorial/standalone page (About, Terms, Privacy, landing, etc.). Same block-based content format as content/home.json: compose from the platform block palette and the platform renders each block with the shared, compliance-aware component library. The page route is derived from the file name (content/pages/about.json -> /about). Pin the contract with the 'contract' field.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "contract": { "type": "string", "description": "Pinned block contract, e.g. \"block-palette@3\".", "examples": ["block-palette@3"] },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "string" },
    "blocks": {
      "type": "array",
      "description": "Ordered list of blocks rendered top-to-bottom.",
      "items": { "$ref": "#/definitions/block" }
    }
  },
  "required": ["blocks"],
  "definitions": {
    "productSource": {
      "description": "How a product section is populated. Use a shortcut string, or a source object.",
      "oneOf": [
        { "type": "string", "enum": ["featured", "newest", "bestSelling", "onSale"] },
        { "type": "object", "additionalProperties": false, "properties": { "collection": { "type": "string" } }, "required": ["collection"] },
        { "type": "object", "additionalProperties": false, "properties": { "tag": { "type": "string" } }, "required": ["tag"] },
        { "type": "object", "additionalProperties": false, "properties": { "handles": { "type": "array", "items": { "type": "string" } } }, "required": ["handles"] },
        { "type": "object", "additionalProperties": false, "properties": { "related": { "type": "string" } }, "required": ["related"] },
        { "type": "object", "additionalProperties": false, "properties": { "recentlyViewed": { "type": "boolean" } }, "required": ["recentlyViewed"] }
      ]
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string" },
        "variant": { "type": "string", "enum": ["primary", "secondary", "ghost"] }
      },
      "required": ["label", "href"]
    },
    "block": {
      "type": "object",
      "required": ["component"],
      "properties": { "component": { "type": "string" } },
      "allOf": [
        {
          "if": { "properties": { "component": { "const": "hero" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "headline": { "type": "string" },
              "subhead": { "type": "string" },
              "ctaLabel": { "type": "string" },
              "ctaHref": { "type": "string" },
              "image": { "type": "string", "description": "Path under public/**" }
            },
            "required": ["headline"]
          }
        },
        {
          "if": { "properties": { "component": { "enum": ["featured_products", "featured_collections"] } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "title": { "type": "string" },
              "eyebrow": { "type": "string" },
              "source": { "$ref": "#/definitions/productSource" },
              "limit": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "editorial" } } },
          "then": {
            "additionalProperties": true,
            "properties": {
              "component": {},
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "newsletter" } } },
          "then": {
            "additionalProperties": true,
            "properties": {
              "component": {},
              "title": { "type": "string" },
              "body": { "type": "string" },
              "placeholder": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "marketing_hero" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "headline": { "type": "string" },
              "subhead": { "type": "string" },
              "body": { "type": "string" },
              "trust": { "type": "array", "items": { "type": "string" } },
              "ctas": { "type": "array", "items": { "$ref": "#/definitions/cta" } },
              "panel": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "title": { "type": "string" }, "lines": { "type": "array", "items": { "type": "string" } } },
                "required": ["lines"]
              }
            },
            "required": ["headline"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "trust_bar" } } },
          "then": {
            "additionalProperties": false,
            "properties": { "component": {}, "items": { "type": "array", "items": { "type": "string" } } },
            "required": ["items"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "split_compare" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "subhead": { "type": "string" },
              "before": { "$ref": "#/definitions/titledItems" },
              "after": { "$ref": "#/definitions/titledItems" }
            },
            "required": ["title", "before", "after"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "steps" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "subhead": { "type": "string" },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "icon": { "type": "string" }, "label": { "type": "string" }, "detail": { "type": "string" } },
                  "required": ["label"]
                }
              }
            },
            "required": ["title", "steps"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "card_grid" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "anchor": { "type": "string" },
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "subhead": { "type": "string" },
              "variant": { "type": "string", "enum": ["capability", "industry", "feature"] },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "icon": { "type": "string" },
                    "title": { "type": "string" },
                    "body": { "type": "string" },
                    "meta": { "type": "string" },
                    "href": { "type": "string" }
                  },
                  "required": ["title"]
                }
              },
              "footnote": { "type": "string" }
            },
            "required": ["title", "cards"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "integrations" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "subhead": { "type": "string" },
              "platforms": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string" }, "href": { "type": "string" } }, "required": ["label"] }
              },
              "points": { "type": "array", "items": { "type": "string" } },
              "code": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "language": { "type": "string" }, "caption": { "type": "string" }, "code": { "type": "string" } },
                "required": ["code"]
              }
            },
            "required": ["title"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "proof_strip" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "testimonials" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "quotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "stat": { "type": "string" }, "quote": { "type": "string" }, "attribution": { "type": "string" } },
                  "required": ["quote"]
                }
              },
              "ratings": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "faq" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": false, "properties": { "q": { "type": "string" }, "a": { "type": "string" } }, "required": ["q", "a"] }
              }
            },
            "required": ["items"]
          }
        },
        {
          "if": { "properties": { "component": { "const": "cta_band" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "component": {},
              "title": { "type": "string" },
              "subhead": { "type": "string" },
              "ctas": { "type": "array", "items": { "$ref": "#/definitions/cta" } }
            },
            "required": ["title"]
          }
        }
      ]
    },
    "titledItems": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "items": { "type": "array", "items": { "type": "string" } } },
      "required": ["title", "items"]
    }
  }
}
